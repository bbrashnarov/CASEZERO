; Engine configuration file.
; CASE ZERO Vertical Slice. Godot 4.7.2-stable (TD-001).

config_version=5

[application]

config/name="CASE ZERO"
config/version="0.1.0"
run/main_scene="res://scenes/SCN_BOOT.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.12549, 0.180392, 0.219608, 1)
config/quit_on_go_back=false
config/auto_accept_quit=false

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=432
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=false

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.12549, 0.180392, 0.219608, 1)
